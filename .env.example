# CareerLine configuration. Copy to .env and fill in. NEVER commit .env.
#
# Generate the two secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"                       # POSTGRES_PASSWORD
#   python -c "import secrets,base64; print('1:'+base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip('='))"   # ENCRYPTION_KEYS

# Database password (Docker Compose only; the local runner manages its own DB).
POSTGRES_PASSWORD=

# Encrypts sensitive fields (two-factor secrets, API keys, contact details, attachments) and keys backups.
# Format: <version>:<base64url 32-byte key>. Back this up: losing it makes those fields unreadable.
# To rotate: put the new key first and keep the old one after it, e.g. 2:<new>,1:<old>
CAREERLINE_ENCRYPTION_KEYS=

# production | development (development enables /api/docs)
CAREERLINE_ENV=production

# true once served over HTTPS (required for __Host- cookies and HSTS). Use false for plain http://localhost.
CAREERLINE_COOKIE_SECURE=false
CAREERLINE_HSTS=false

# The first account is always allowed. Set true to let more people sign up.
CAREERLINE_ALLOW_REGISTRATION=false

# Host port for Docker Compose.
CAREERLINE_PORT=8080
# Host address the port is published on. 127.0.0.1 = this machine only (default).
# Use the server's LAN IP (e.g. 192.168.1.50) or 0.0.0.0 to reach it from other devices
# on a trusted network. Over plain http, keep CAREERLINE_COOKIE_SECURE=false.
# CAREERLINE_BIND=127.0.0.1

# Where CareerLine is reached from outside (links in notifications, single sign-on redirect).
# CAREERLINE_PUBLIC_URL=https://careerline.example.com

# Let job sources, AI endpoints, and notifications reach LAN addresses for every user.
# (The owner may always use LAN addresses for AI and notifications.)
# CAREERLINE_OUTBOUND_ALLOW_PRIVATE=false

# --- Email notifications (one SMTP server for the whole instance) ---
# CAREERLINE_SMTP_HOST=smtp.example.com
# CAREERLINE_SMTP_PORT=587
# starttls | tls (implicit TLS, port 465) | none (localhost relay only)
# CAREERLINE_SMTP_SECURITY=starttls
# CAREERLINE_SMTP_USERNAME=
# CAREERLINE_SMTP_PASSWORD=
# CAREERLINE_SMTP_FROM=CareerLine <careerline@example.com>

# --- Backups (the Docker image already sets CAREERLINE_BACKUP_DIR=/backups) ---
# Optional separate key; by default a key derived from CAREERLINE_ENCRYPTION_KEYS is used.
# CAREERLINE_BACKUP_KEY=
# CAREERLINE_BACKUP_INTERVAL_HOURS=24
# CAREERLINE_BACKUP_KEEP=14

# --- Single sign-on (OpenID Connect: Authelia, Authentik, Keycloak, ...) ---
# CAREERLINE_OIDC_ISSUER=https://auth.example.com
# CAREERLINE_OIDC_CLIENT_ID=careerline
# CAREERLINE_OIDC_CLIENT_SECRET=
# CAREERLINE_OIDC_LABEL=Authelia
# CAREERLINE_OIDC_AUTO_CREATE=false
# CAREERLINE_OIDC_LINK_BY_EMAIL=false
# CAREERLINE_PASSWORD_LOGIN=true

# Demo mode: fictional data, registration closed, nothing sent outside the server.
# CAREERLINE_DEMO_MODE=false
